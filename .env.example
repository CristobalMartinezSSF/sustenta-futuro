# =============================================================================
# .env.example — Sustenta Futuro MVP
#
# Copy this file to .env (never commit .env) and fill in real values.
# All secrets must be kept out of version control.
# =============================================================================


# -----------------------------------------------------------------------------
# SUPABASE
# -----------------------------------------------------------------------------

# Public URL for your Supabase project (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co

# Anon / public key — used by the Next.js client and FastAPI for anon queries
# This key enforces RLS; it is safe to include in frontend bundles.
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# Service-role key — NEVER expose to the browser or commit to git.
# Used only by the FastAPI backend for privileged DB operations.
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# Direct Postgres connection string (optional; useful for migrations via psql)
# Format: postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:<password>@db.<your-project-ref>.supabase.co:5432/postgres


# -----------------------------------------------------------------------------
# FASTAPI BACKEND
# -----------------------------------------------------------------------------

# Secret used to sign internal JWT tokens if needed (generate with: openssl rand -hex 32)
API_SECRET_KEY=<generate-a-strong-random-secret>

# Environment: development | staging | production
ENVIRONMENT=development

# CORS origins the API will accept (comma-separated, no trailing slash)
CORS_ALLOWED_ORIGINS=http://localhost:3000


# -----------------------------------------------------------------------------
# RESEND (transactional email)
# -----------------------------------------------------------------------------

RESEND_API_KEY=re_<your-resend-api-key>

# The verified sender address configured in your Resend account
EMAIL_FROM=no-reply@yourdomain.com

# Internal address that receives new-lead notifications
EMAIL_INTERNAL_NOTIFY=team@yourdomain.com


# -----------------------------------------------------------------------------
# NEXT.JS FRONTEND
# -----------------------------------------------------------------------------

# Full URL of the FastAPI backend reachable from the browser
NEXT_PUBLIC_API_URL=http://localhost:8000


# -----------------------------------------------------------------------------
# LEAD ENRICHMENT (v4) — all optional; enrichment works without any of them.
# Each one only widens coverage / unblocks a source.
# -----------------------------------------------------------------------------

# HTTP(S) proxy for the fragile scrapers (SII, Rutificador, LinkedIn, etc.).
# Render's datacenter IP is blocked by several sources; routing through a proxy
# restores them. Format: http://user:pass@host:port
SCRAPER_PROXY=

# Google Custom Search (free tier: 100 queries/day). Preferred over DuckDuckGo
# because it runs from any IP. Create at https://programmablesearchengine.google.com
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=

# Mercado Público / ChileCompra official API ticket (free on registration).
# Enables counting public-sector purchase orders by RUT.
MERCADO_PUBLICO_TICKET=

# Optional AI synthesis over collected public signals (OpenAI-compatible API,
# e.g. a local Ollama server). The model ONLY synthesises — it runs no searches.
# ENRICH_LLM_URL=http://localhost:11434   (Ollama; endpoint /v1/chat/completions)
ENRICH_LLM_URL=
ENRICH_LLM_MODEL=llama3.1
ENRICH_LLM_KEY=
